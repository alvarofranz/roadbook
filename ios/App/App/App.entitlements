<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links (#268): the app claims https://rdbk.app links so a scanned /go/<code>
	     (and event / public-roadbook pages) opens the app instead of Safari. Requires the
	     Associated Domains capability enabled on the App ID in the Apple Developer portal. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rdbk.app</string>
	</array>
	<!-- Sign in with Apple (#370): required by App Store guideline 4.8 next to Google Sign-In. The
	     OS sheet returns the identity token straight to the app, which posts it to /api apple_auth.
	     Requires the Sign In with Apple capability enabled on the App ID in the Apple Developer
	     portal (the provisioning profile carries it). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
