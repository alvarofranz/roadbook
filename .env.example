# Copy to .env (gitignored) and fill in. On prod it lives at the repo root and
# survives deploys (untracked). Never commit the real .env.
DB_HOST=127.0.0.1
DB_NAME=rdbk
DB_USER=rdbk
DB_PASS=CHANGE_ME
SENDGRID_KEY=SG.CHANGE_ME
MAIL_FROM=info@rdbk.app
MAIL_FROM_NAME=RDBK.app
BASE_URL=https://rdbk.app
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Comma-separated emails always granted admin (manage users · disk usage). The first
# admin is bootstrapped here (kept out of the repo); further admins via the admin panel.
ADMIN_EMAILS=
# Google Sign-In (#46): OAuth client IDs (comma-separated), WEB FIRST — the web id drives the
# button and is the token audience. Add the native clients too (iOS + Android) so native-app ID
# tokens also verify. Get them from Google Cloud → Credentials.
GOOGLE_CLIENT_IDS=
# Sign in with Apple (#370). Both are accepted token audiences and both are optional — the button
# appears only where its id is set. APPLE_SERVICE_ID is the Services ID from Apple Developer →
# Identifiers (needs rdbk.app verified + https://rdbk.app/account/ as a return URL) and drives the
# web button; APPLE_APP_ID is the iOS bundle id, which is the audience of tokens from the app.
APPLE_SERVICE_ID=
APPLE_APP_ID=app.rdbk
