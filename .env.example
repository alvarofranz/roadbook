# Copy to .env (gitignored) and fill in. On prod it lives at the repo root and
# survives deploys (untracked). Never commit the real .env.
DB_HOST=127.0.0.1
DB_NAME=rdbk
DB_USER=rdbk
DB_PASS=CHANGE_ME
SENDGRID_KEY=SG.CHANGE_ME
MAIL_FROM=info@rdbk.app
MAIL_FROM_NAME=RDBK.app
BASE_URL=https://rdbk.app
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Comma-separated emails always granted admin (manage users · disk usage). The first
# admin is bootstrapped here (kept out of the repo); further admins via the admin panel.
ADMIN_EMAILS=
