{
  "name": "rdbk-app",
  "version": "0.0.0",
  "private": true,
  "description": "RDBK.app — native shells (iOS + Android) for the rdbk.app PWA, via Capacitor. The web app in public/ stays the single source of truth.",
  "license": "WTFPL",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node source/check-syntax.mjs",
    "stamp": "node source/stamp-version.mjs",
    "build:native": "esbuild native/src/native.js --bundle --format=iife --outfile=public/assets/js/native.bundle.js --target=es2019",
    "sync": "npm run build:native && cap sync",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/background-geolocation": "^8.0.42"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^15.11.7",
    "vitest": "^2.1.8"
  }
}
