{
    "name": "RDBK.app",
    "short_name": "RDBK",
    "description": "Digital roadbooks for any adventure: create, navigate, validate and rank. The open .rdbk format.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#0e1116",
    "theme_color": "#0e1116",
    "icons": [
        { "src": "assets/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
        { "src": "assets/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "assets/web-app-manifest-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
    ],
    "file_handlers": [
        { "action": "./reader/", "accept": { "application/x-roadbook": [".rdbk"] } }
    ]
}
