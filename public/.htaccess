# Custom error pages (#286)
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Never list directory contents: private media (photos/, audio/) relies on unguessable
# filenames, and an autoindex would hand the whole list to anyone (#210).
Options -Indexes

# RDBK.app — MIME type for roadbook files (.rdbk = JSON).
AddType application/x-roadbook .rdbk

# Uploaded media (photos/covers/avatars/event logos) is re-encoded to AVIF; without an explicit
# MIME type Apache serves it with no Content-Type and stricter mobile engines drop the image.
AddType image/avif .avif

# Voice notes (recorded WP audio): explicit MIME so every host serves them playable.
AddType audio/webm .webm
AddType audio/mp4 .m4a
AddType audio/ogg .ogg
AddType audio/mpeg .mp3

# Cache policy: the app shell (HTML/JS/CSS/JSON/SVG) must follow deploys
# IMMEDIATELY — always-revalidate (cheap 304s via Last-Modified/ETag) so neither
# browsers nor the CDN edge ever pin an old mix of files. Without this the CDN
# applies its default static TTL and a deploy ships new HTML with hours-old JS.
# Uploaded media, pictogram PNGs and the vendored fonts change rarely → cache long.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css|json|svg|rdbk)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|avif|gif|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # The native app reads the live version from the production host, cross-origin, so its footer
    # always shows the current unified version (web + app move together). version.json is public.
    <Files "version.json">
        Header set Access-Control-Allow-Origin "*"
    </Files>

    # Security headers. The CSP is the important one: it forbids inline scripts (the site carries
    # none — the one bootstrap moved to assets/js/native-detect.js), so an injected <script> can't
    # run, and it whitelists exactly the external origins we actually load from. Keep this list in
    # sync when adding a third-party resource, or the browser will block it:
    #   script  — MapLibre GL (unpkg), transformers.js/Whisper (jsdelivr), Google Sign-In
    #             (accounts.google.com + gstatic), Sign in with Apple (appleid.cdn-apple.com),
    #             Cloudflare Turnstile; 'wasm-unsafe-eval' is the narrow allowance ONNX/WASM needs
    #             (it does NOT permit eval()).
    #   style   — MapLibre's stylesheet (unpkg) + Google Sign-In's stylesheet (gsi/style);
    #             'unsafe-inline' covers MapLibre's element styles.
    #   img     — map raster tiles (OSM · CyclOSM · ESRI satellite · terrain DEM on S3), plus
    #             data:/blob: for generated vignettes, QR codes and captured photos.
    #   connect — MapLibre's worker fetched from unpkg, vector tiles/glyphs (OpenFreeMap), the tile
    #             hosts, the transformers CDN + the Hugging Face model host, and the
    #             Google/Apple/Cloudflare auth widgets.
    #   media   — recorded voice notes played back from blob: URLs.  worker/frame — MapLibre &
    #             transformers workers (blob:), the Google, Apple & Turnstile iframes.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://accounts.google.com https://www.gstatic.com https://appleid.cdn-apple.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://accounts.google.com; img-src 'self' data: blob: https://www.gstatic.com https://tile.openstreetmap.org https://a.tile-cyclosm.openstreetmap.fr https://b.tile-cyclosm.openstreetmap.fr https://c.tile-cyclosm.openstreetmap.fr https://tiles.openfreemap.org https://server.arcgisonline.com https://elevation-tiles-prod.s3.amazonaws.com; font-src 'self' data:; media-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' https://unpkg.com https://tiles.openfreemap.org https://tile.openstreetmap.org https://a.tile-cyclosm.openstreetmap.fr https://b.tile-cyclosm.openstreetmap.fr https://c.tile-cyclosm.openstreetmap.fr https://server.arcgisonline.com https://elevation-tiles-prod.s3.amazonaws.com https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://accounts.google.com https://appleid.apple.com https://challenges.cloudflare.com; frame-src https://accounts.google.com https://appleid.apple.com https://challenges.cloudflare.com"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Universal Links / App Links (#268): the /.well-known association files let an installed
# iOS/Android app open rdbk.app links (the /go/<code> event join, event + public-roadbook
# pages) instead of the browser. Apple's file has NO extension, so force its JSON type;
# assetlinks.json already serves as JSON. Both must be reachable over HTTPS with no redirect.
<Files "apple-app-site-association">
    ForceType application/json
</Files>

# Friendly URLs: /challenge/<slug>, /reader/<slug>, /editor/<slug>, /event/<slug> → the page
# (only when the path isn't a real file or directory). The trailing-slash form
# redirects to the canonical one first — the pages load their assets via
# relative ../ paths, which would break one level deeper.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # PHP-FPM does not receive the Authorization header unless it is explicitly forwarded.
    # The native apps authenticate with a Bearer token (no cross-origin cookie), so without
    # this every app API call arrives unauthenticated and the app looks signed out — expose it.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^(challenge|reader|editor|event|go)/([A-Za-z0-9_-]+)/$ /$1/$2 [R=301,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(challenge|reader|editor|event)/[A-Za-z0-9_-]+$ /$1/index.html [L]
    RewriteRule ^go/([A-Za-z0-9_-]+)$ /go/index.php?tag=$1 [L]
</IfModule>
