# Custom error pages (#286)
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Never list directory contents: private media (photos/, audio/) relies on unguessable
# filenames, and an autoindex would hand the whole list to anyone (#210).
Options -Indexes

# RDBK.app — MIME type for roadbook files (.rdbk = JSON).
AddType application/x-roadbook .rdbk

# Uploaded media (photos/covers/avatars/event logos) is re-encoded to AVIF; without an explicit
# MIME type Apache serves it with no Content-Type and stricter mobile engines drop the image.
AddType image/avif .avif

# Voice notes (recorded WP audio): explicit MIME so every host serves them playable.
AddType audio/webm .webm
AddType audio/mp4 .m4a
AddType audio/ogg .ogg
AddType audio/mpeg .mp3

# Cache policy: the app shell (HTML/JS/CSS/JSON/SVG) must follow deploys
# IMMEDIATELY — always-revalidate (cheap 304s via Last-Modified/ETag) so neither
# browsers nor the CDN edge ever pin an old mix of files. Without this the CDN
# applies its default static TTL and a deploy ships new HTML with hours-old JS.
# Uploaded media, pictogram PNGs and the vendored fonts change rarely → cache long.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css|json|svg|rdbk)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|avif|gif|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # The native app reads the live version from the production host, cross-origin, so its footer
    # always shows the current unified version (web + app move together). version.json is public.
    <Files "version.json">
        Header set Access-Control-Allow-Origin "*"
    </Files>
</IfModule>

# Universal Links / App Links (#268): the /.well-known association files let an installed
# iOS/Android app open rdbk.app links (the /go/<code> event join, event + public-roadbook
# pages) instead of the browser. Apple's file has NO extension, so force its JSON type;
# assetlinks.json already serves as JSON. Both must be reachable over HTTPS with no redirect.
<Files "apple-app-site-association">
    ForceType application/json
</Files>

# Friendly URLs: /challenge/<slug>, /reader/<slug>, /editor/<slug>, /event/<slug> → the page
# (only when the path isn't a real file or directory). The trailing-slash form
# redirects to the canonical one first — the pages load their assets via
# relative ../ paths, which would break one level deeper.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # PHP-FPM does not receive the Authorization header unless it is explicitly forwarded.
    # The native apps authenticate with a Bearer token (no cross-origin cookie), so without
    # this every app API call arrives unauthenticated and the app looks signed out — expose it.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^(challenge|reader|editor|event|go)/([A-Za-z0-9_-]+)/$ /$1/$2 [R=301,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(challenge|reader|editor|event)/[A-Za-z0-9_-]+$ /$1/index.html [L]
    RewriteRule ^go/([A-Za-z0-9_-]+)$ /go/index.php?tag=$1 [L]
</IfModule>
